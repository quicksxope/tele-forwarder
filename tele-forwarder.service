# Alternative to docker-compose — use one or the other, not both.
# See CLAUDE.md for the docker-compose workflow (preferred for new installs).
[Unit]
Description=Telegram Message Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devops
WorkingDirectory=/home/devops/repo/tele-forwarder
Environment=PATH=/home/devops/repo/tele-forwarder/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=TELE_FORWARDER_DATA_DIR=/home/devops/repo/tele-forwarder/data
ExecStart=/home/devops/repo/tele-forwarder/.venv/bin/python3 forwarder.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
