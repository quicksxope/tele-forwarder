# Telegram (optional if secrets.yaml already set)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=

# Switch channel without code changes:
#   1) edit okx_bot/channels.yaml  OR
#   2) set ACTIVE_CHANNEL=dex_vip
ACTIVE_CHANNEL=dex_vip
# Optional override (else chat_id comes from channels.yaml):
# SIGNAL_CHAT_ID=-1002290536326
NOTIF_CHAT_ID=6878724303

# Exchange: okx | bybit
EXCHANGE=okx

# OKX API (from OKX → API Management). Passphrase = OKX_PASSWORD.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
OKX_SANDBOX=false

# Bybit API
#   BYBIT_DEMO=true   → demo trading (api-demo.bybit.com) — keys from Bybit Demo Trading
#   BYBIT_SANDBOX=true → testnet (api-testnet.bybit.com) — mutually exclusive with DEMO
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_DEMO=false
BYBIT_SANDBOX=false

# Trading
TRADE_DRY_RUN=true
TRADE_AMOUNT=1
# % of USDT equity per trade (0 = use TRADE_AMOUNT fixed size)
# TRADE_EQUITY_PCT=5
# TRADE_EQUITY_DRY_USDT=5000
TRADE_LEVERAGE=5
TRADE_MARGIN_MODE=cross
TRADE_ORDER_TYPE=limit
TRADE_POSITION_MODE=net

# Reporting / backtest
REPORT_WEEKS=1

# Supabase / Postgres (optional — trades go here instead of local SQLite)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...          # required for bot writes (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...           # legacy JWT name (also works)
