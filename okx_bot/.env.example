# Master encryption key for per-user API credentials stored in DB.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit the actual key — store in env/secrets only.
CREDENTIAL_ENCRYPTION_KEY=

# Telegram (optional if secrets.yaml already set)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=

# Switch channel without code changes:
#   1) edit okx_bot/channels.yaml  OR
#   2) set ACTIVE_CHANNEL=dex_vip
ACTIVE_CHANNEL=dex_vip
# Optional override (else chat_id comes from channels.yaml):
# SIGNAL_CHAT_ID=-1002290536326
NOTIF_CHAT_ID=6878724303
# true = DM parsed signal only, skip exchange orders
# SIGNAL_PARSE_ONLY=true

# Exchange: okx | bybit | binance (legacy default if runtime file empty)
EXCHANGE=okx
# Comma-separated venues enabled on first start (overridden by /settings → Venue ON/OFF)
# ENABLED_EXCHANGES=okx,binance
# false = ignore per-user DB credentials and force keys from this env file
PREFER_DB_CREDENTIALS=true

# OKX API (from OKX → API Management). Passphrase = OKX_PASSWORD.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
# true = Demo Trading keys (CCXT sets x-simulated-trading). false = live.
OKX_SANDBOX=true

# Bybit API
#   BYBIT_DEMO=true   → demo trading (api-demo.bybit.com) — keys from Bybit Demo Trading
#   BYBIT_SANDBOX=true → testnet (api-testnet.bybit.com) — mutually exclusive with DEMO
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_DEMO=false
BYBIT_SANDBOX=false

# Binance API (USDT-M futures via CCXT defaultType=future)
#   BINANCE_DEMO=true   → demo trading (demo-fapi.binance.com) — keys from demo.binance.com API Management
#   BINANCE_SANDBOX=true → futures testnet (testnet.binancefuture.com) — mutually exclusive with DEMO
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_DEMO=false
BINANCE_SANDBOX=false

# Trading
TRADE_DRY_RUN=false
# Fixed base-coin size when TRADE_EQUITY_PCT=0
TRADE_AMOUNT=1
# % of USDT wallet balance used as margin per trade (live: fetch_balance; dry-run: TRADE_EQUITY_DRY_USDT)
# Example: 5000 USDT × 10% × 10x leverage ≈ 5000 USDT notional per signal.
TRADE_EQUITY_PCT=10
TRADE_EQUITY_DRY_USDT=5000
TRADE_LEVERAGE=5
TRADE_MARGIN_MODE=cross
TRADE_ORDER_TYPE=limit
TRADE_POSITION_MODE=net

# Reporting / backtest
REPORT_WEEKS=1

# Supabase / Postgres (optional — trades go here instead of local SQLite)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...          # required for bot writes (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...           # legacy JWT name (also works)
